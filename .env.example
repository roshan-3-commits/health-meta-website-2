# Frontend settings (Vite). Values starting with VITE_ are PUBLIC: they end up in the website code.
# Never put a secret key in a VITE_ variable.

# Google "Continue with Google" button. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Only when the backend runs on a different domain. Leave empty on Vercel.
VITE_API_URL=
