# Copy this file to backend/.env and fill in what you need.

# Database. Leave empty to use the local SQLite file backend/healthmeta.db
# Online (Vercel): paste your Neon Postgres connection string, e.g.
#   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Set it here too if you want show_data.py to show the ONLINE data.
DATABASE_URL=

# Secret key for the admin routes (/api/admin/auth-events, /api/admin/sessions).
# Use a long random value. Admin routes are disabled while this is empty.
ADMIN_API_KEY=

# How many days a login stays valid
SESSION_DAYS=30

# Frontend URLs allowed to call this API (comma separated)
# (a GitHub Pages site is listed by its domain only, without the repo name)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://roshan-3-commits.github.io

# Set to 1 only when running behind nginx / a load balancer (automatic on Vercel)
TRUST_PROXY=0

# Google sign-in: the same OAuth Web Client ID as VITE_GOOGLE_CLIENT_ID.
# Empty = Google sign-in is turned off (email/password still works).
GOOGLE_CLIENT_ID=

# AI food scanner. If empty, the built-in food matcher is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used in order when the main model is busy. Empty = built-in list.
GEMINI_FALLBACK_MODELS=

# Email
WELCOME_FROM_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
APP_URL=
